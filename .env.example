# tiktok_logger — example configuration. Do not edit by hand for a first install:
#   ./scripts/setup.sh                 generates this file with strong random secrets (ACME TLS through Caddy)
#   ./scripts/setup.sh --http-only     for running behind your own TLS reverse proxy
# Every value below is read by docker compose; the app reads its own subset (see ARCHITECTURE.md §9).

# --- Network / TLS (docker compose + caddy)
# The address you open tiktok_logger at: a domain (ACME certificate) or an IP (internal CA).
SITE_ADDRESS=tt.example.com
# acme (default: real Let's Encrypt certificate for SITE_ADDRESS) | internal (Caddy's own CA; browsers warn)
CADDY_TLS=acme
HTTPS_PORT=443
HTTP_PORT=80
# Exact origin your browser uses; requests from any other origin are rejected. Unset = derived from Host.
# PUBLIC_ORIGIN=https://tt.example.com

# --- Secrets (generated by setup.sh; never share them)
# Needed once, on the signup page, to create the first account (the admin).
SETUP_TOKEN=change-me-to-32-random-bytes-please
# Shared by the app and chromium containers only (per-user browser tokens are derived from it).
CONTROL_SECRET=change-me-too-32-random-bytes
# A server time zone: TikTok compares it with your IP's region. Use the one you normally use the account in.
TZ=Europe/Istanbul

# --- Users
# MAX_USERS also sizes the chromium container: ~1.5 GB RAM per active user.
MAX_USERS=10
# Ports the admin can give to other users (published by caddy), and the address they are published on.
EXTRA_PORTS=8101-8110
EXTRA_BIND=127.0.0.1

# --- Sessions
SESSION_IDLE_HOURS=8
SESSION_MAX_DAYS=7

# --- Logging behaviour (defaults; most can be changed later in Settings)
MEDIA_MAX_MB=100
HISTORY_PER_CHAT=100
RECONCILE_MINUTES=10
LOG_LEVEL=info
SCREEN=1280x800x24

# --- Reverse proxy
# Number of proxy hops to trust for X-Forwarded-*: 0 none, 1 the bundled Caddy, 2 Caddy + your own proxy in front of it.
# In HTTP mode behind Nginx Proxy Manager this must be 2. Too low: every client looks like the proxy (one lockout locks
# everyone). Too high: clients can choose their own IP.
TRUST_PROXY=1
# true (default) | auto (Secure cookies only when the request arrived over HTTPS) | false (local HTTP only)
COOKIE_SECURE=true

# --- TikTok layer (rarely needed)
# Pause between conversations during the import/re-check, in ms (keeps the account's traffic human-like).
# TT_REQUEST_GAP_MS=1500
# Extra CSS selectors for the messages page when TikTok renames something (JSON, each list extends the built-in ones).
# See Settings → TikTok → Diagnostics for the page's structure.
# TT_DOM_SELECTORS={"messageList":["[class*=\"DivMessageList\"]"],"messageRow":["[class*=\"DivMessageItem\"]"]}
# Disable the TikTok connection entirely (API-only development / tests).
# TT_ENABLED=false
